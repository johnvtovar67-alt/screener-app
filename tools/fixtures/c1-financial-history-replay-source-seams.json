      "chunks": [
        {
          "before": " return clone((capabilities.get(replay)?.openingEvents||[]).filter(event=>event.date===date));\n}\n\n// EOD cash flows follow the original recorded fills and in-kind adoption.\n// Capital movements preserve the drawdown percentage at the flow. Income,\n// fees and statement-net corrections change P&L and do not scale references.\n",
          "after": " return clone((capabilities.get(replay)?.openingEvents||[]).filter(event=>event.date===date));\n}\n\n// Only the detached, server-validated journal supplies this capability. Bind it\n// to the same allocation and original account units; JSON flags/copies cannot\n// turn a hypothetical order into a recorded financial-history execution.\nexport function c1HasCashFlowReplay(replay,seed){\n const proof=capabilities.get(replay);\n return Boolean(proof&&seed?.sleeve===proof.sleeve&&seed.actualDollarsPerModelDollar===proof.actualDollarsPerModelDollar);\n}\n\n// EOD cash flows follow the original recorded fills and in-kind adoption.\n// Capital movements preserve the drawdown percentage at the flow. Income,\n// fees and statement-net corrections change P&L and do not scale references.\n"
        }
